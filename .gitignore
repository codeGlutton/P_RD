# Visual Studio 2015 user specific files
.vs/

# IDE / Editor tools
.agents/
.idea/
.claude/
.vsconfig
CLAUDE.md
GEMINI.md

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# SVN
/Content/SVN/

# Imported resource assets are stored in SVN, not Git.
/Content/Audio/
/Content/**/T_*.uasset
/Content/**/S_*.uasset
# 이번 런 화면 배경은 외부 SVN이 아니라 Git PR로 함께 배포한다.
!/Content/UI/Art/RunFlow/T_*.uasset

# Doxygen Preiview Output
/Doxygen/Preview/Output

# AI 이미지 생성 산출물(빌드 미참조, SVN/외부에서 관리)
GeneratedImages/

# gdep 툴 로컬 데이터 / 파이썬 캐시 (커밋 금지)
/.gdep/
__pycache__/
*.pyc

# 이전에 사용하던 파일
.svnrev

# 굽는 도구가 만든 것과 그 재료. 저장소에 안 둔다.
#
# 결과(uasset)는 SVN 에 있고 그림 재료(PNG)와 도구는 각자 손에만 둔다.
# 여기 두면 같은 그림이 두 벌 들어가고, 도구가 만든 보고서까지 따라 들어온다.
/Docs/
/Tools/UI/_*
/Tools/UI/KayKitUIKit/
/Tools/UI/*.html
/Tools/UI/*.json
__MACOSX/

# 도구가 옆에 흘려 놓는 것들. 전체를 담을 때 딸려 들어온다.
/work/
/outputs/
.gdep/
