#. SourceLocation:	Source/P_RD/GameMode/FrontendGameMode.cpp(89)
#: Source/P_RD/GameMode/FrontendGameMode.cpp(89)
msgctxt "FrontendGameMode,KnightDescription"
msgid "A melee guardian who holds the front line with heavy armor and a shield.\nHigh HP lets him endure enemy attacks."
msgstr "두꺼운 갑옷과 방패로 전열을 지키는 근접 수호자.\n높은 체력으로 적의 공격을 버틴다."

#. Key:	ArcherDescription
#. SourceLocation:	Source/P_RD/GameMode/FrontendGameMode.cpp(91)
#: Source/P_RD/GameMode/FrontendGameMode.cpp(91)
msgctxt "FrontendGameMode,ArcherDescription"
msgid "A nimble assassin who strikes from the shadows.\nFast follow-up attacks bring enemies down."
msgstr "그림자에서 기습하는 민첩한 암살자.\n빠른 연속 공격으로 적을 무너뜨린다."

#. Key:	MageDescription
#. SourceLocation:	Source/P_RD/GameMode/FrontendGameMode.cpp(93)
#: Source/P_RD/GameMode/FrontendGameMode.cpp(93)
msgctxt "FrontendGameMode,MageDescription"
msgid "A ranged spellcaster who deals area damage with dice magic.\nPowerful, but fragile."
msgstr "주사위 마법으로 광역 피해를 주는 원거리 술사.\n강력하지만 체력이 낮다."

